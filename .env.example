NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server-only, never expose (Supabase > Project Settings > API > service_role / secret key)
SUPABASE_SERVICE_ROLE_KEY=
# AI (optional). Set ONE of these; without a key, search uses rules and descriptions use a template.
# Groq Cloud (keys start with gsk_):
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# or xAI Grok (keys start with xai-):
XAI_API_KEY=
XAI_MODEL=grok-3-mini
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Transactional email — set EMAIL_PROVIDER to the active provider name
# Provider: zepto (ZeptoMail — recommended for India)
EMAIL_PROVIDER=zepto
ZEPTO_HOST=cpaas.zoho.com
# Raw encoded key only — do NOT include the "Zoho-enczapikey" prefix here
ZEPTO_API_KEY=
NOTIFY_EMAIL_FROM=PLOTSS <noreply@yourdomain.com>

# WhatsApp / SMS (optional)
# WHATSAPP_PROVIDER=msg91
# MSG91_API_KEY=
